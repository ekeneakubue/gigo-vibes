generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  PENDING
  REFUNDED
}

/// Student who purchased (or was granted) course access.
model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  /// Store a hashed password in production — never plain text.
  password  String
  status    UserStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

/// Curriculum module shown on the marketing site and managed in /admin/curriculum.
model CurriculumModule {
  id          String   @id @default(cuid())
  label       String
  title       String
  description String
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  lessons     Lesson[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@map("curriculum_modules")
}

/// Ordered lesson within a curriculum module.
model Lesson {
  id        String           @id @default(cuid())
  title     String
  sortOrder Int              @default(0)
  moduleId  String
  module    CurriculumModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([moduleId, sortOrder])
  @@map("lessons")
}

/// FAQ entry shown on the marketing site and managed in /admin/faqs.
model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("faqs")
}

/// Technology shown on the marketing stack section and managed in /admin/tech-stack.
model TechStackItem {
  id        String   @id @default(cuid())
  name      String
  mark      String
  logo      String   @default("")
  layer     String
  purpose   String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("tech_stack_items")
}
